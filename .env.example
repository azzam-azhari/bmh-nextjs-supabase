# ===========================================
# Environment Variables Template
# ===========================================
# Copy this file to .env.local and fill in the values
# cp .env.example .env.local
# ===========================================

# --- Supabase ---
# Get these from your Supabase project dashboard:
# https://app.supabase.com → Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-side only — NEVER expose this to the client
# Found in: Supabase Dashboard → Settings → API → service_role key
SUPABASE_SERVICE_ROLE_KEY=

# --- Alibaba Cloud ---
# Used for cloud services (e.g., translation, storage, etc.)
ALIBABA_ACCESS_KEY_ID=
ALIBABA_ACCESS_KEY_SECRET=

# --- Site ---
# Used for metadata base URL (SEO, Open Graph, etc.)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
